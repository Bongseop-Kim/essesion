{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ESSE SION GC sensor summary",
  "type": "object",
  "required": ["schema_version", "mode", "sensors"],
  "properties": {
    "schema_version": { "const": 1 },
    "mode": { "enum": ["full", "changed"] },
    "sensors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sensor",
          "tool_version",
          "scope",
          "status",
          "duration_ms",
          "metrics",
          "findings",
          "suppressed_count",
          "parser_errors",
          "partial"
        ],
        "properties": {
          "sensor": { "type": "string" },
          "tool_version": { "type": ["string", "null"] },
          "scope": { "type": "string" },
          "status": { "enum": ["ok", "unknown"] },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "metrics": { "type": "array" },
          "findings": { "type": "array" },
          "suppressed_count": { "type": "integer", "minimum": 0 },
          "parser_errors": { "type": "array", "items": { "type": "string" } },
          "partial": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
