# 로컬 개발용 — 시크릿과 로컬에서 config 기본값과 달라지는 값만 둔다.
# 설정값의 소스는 각 앱 config.py, 배포 값은 GCP Secret Manager(api·worker) / Cloudflare(프론트).

OPENAI_API_KEY=
RECRAFT_API_KEY=
SENTRY_DSN=

# 소셜 OAuth (비우면 해당 프로바이더 비활성)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 PEM 내용 — 개행은 \n 이스케이프로 한 줄에 (dotenv가 복원)
APPLE_PRIVATE_KEY=

# 배포 전용 — 로컬은 비워둘 것(docker compose의 fake-gcs-server + dev-* 버킷이 기본값).
# 실제 값은 infra/cloudrun.tf가 Cloud Run env로 주입한다. 비우면 배포 환경은 기동 실패.
# GCS_UPLOAD_BUCKET=   # api 비공개 업로드 버킷
# GCS_ASSETS_BUCKET=   # api 공개 assets 버킷
# GCS_BUCKET=          # worker 산출물 버킷 (= assets)
