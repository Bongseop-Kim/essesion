// Cloudflare Workers 정적 자산 배포 (ARCHITECTURE §2 — Pages 아님)
{
  "name": "essesion-store",
  "compatibility_date": "2026-07-01",
  // mp4만 Worker를 먼저 거친다 — 정적 자산이 Range(206)를 지원하지 않아 worker.ts가 잘라 준다.
  "main": "./worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/images/*.mp4"]
  },
  // 루트가 정본. 구 도메인(essesion.shop·app.·www.)은 Cloudflare Single Redirect가 여기로 보낸다
  // (docs/plans/domain-move-essesion-com.md D단계).
  // www는 여기 두지 않는다 — Cloudflare 레코드가 이미 루트로 301하고 있고,
  // 그 레코드가 남은 채로 custom_domain을 걸면 등록이 충돌해 배포가 실패한다.
  "routes": [{ "pattern": "essesion.com", "custom_domain": true }]
}
