{
  "schemaVersion": 1,
  "artifactDirectory": ".gc-artifacts/latest",
  "baseline": "gc-baseline.json",
  "sensors": {
    "knip": {
      "command": [
        "pnpm",
        "exec",
        "knip",
        "--config",
        "knip.json",
        "--reporter",
        "json",
        "--no-exit-code",
        "--no-progress"
      ],
      "parser": "knip",
      "scope": "apps/admin, apps/store, packages/shared, infra/cloudflare/api-proxy",
      "successExitCodes": [0],
      "target": 0,
      "direction": "lower"
    },
    "docs": {
      "command": ["node", "scripts/gc/check-docs.mjs"],
      "parser": "diagnostics",
      "scope": "AGENTS.md, ARCHITECTURE.md, docs, CLAUDE.md pointers",
      "successExitCodes": [0],
      "target": 0,
      "direction": "lower"
    },
    "module-roots": {
      "command": ["node", "scripts/gc/check-module-roots.mjs"],
      "parser": "diagnostics",
      "scope": "apps, packages, libs, db",
      "successExitCodes": [0],
      "target": 0,
      "direction": "lower"
    },
    "dependency-cruiser": {
      "command": [
        "pnpm",
        "exec",
        "depcruise",
        "apps/admin/src",
        "apps/store/src",
        "packages/shared/src",
        "infra/cloudflare/api-proxy/src",
        "--config",
        "dependency-cruiser.config.mjs",
        "--output-type",
        "json"
      ],
      "parser": "dependencyCruiser",
      "scope": "TypeScript client and edge import graph",
      "successExitCodes": [0, 1],
      "target": 0,
      "direction": "lower"
    },
    "import-linter": {
      "command": [
        "uv",
        "run",
        "lint-imports",
        "--config",
        ".importlinter",
        "--no-cache"
      ],
      "parser": "importLinter",
      "scope": "api, worker, db, obs, svg_safety import graph",
      "successExitCodes": [0, 1],
      "target": 0,
      "direction": "lower"
    },
    "jscpd-ts": {
      "command": [
        "pnpm",
        "exec",
        "jscpd",
        "apps/admin/src",
        "apps/store/src",
        "packages/shared/src",
        "infra/cloudflare/api-proxy/src",
        "--min-lines",
        "5",
        "--format",
        "typescript,tsx",
        "--ignore",
        "**/*.test.*,**/tests/**,**/__snapshots__/**",
        "--reporters",
        "json",
        "--silent",
        "--absolute",
        "--output",
        "{output}/jscpd-ts"
      ],
      "parser": "jscpd",
      "report": "jscpd-ts/jscpd-report.json",
      "scope": "TypeScript runtime source",
      "successExitCodes": [0],
      "target": 0,
      "direction": "lower"
    },
    "jscpd-python": {
      "command": [
        "pnpm",
        "exec",
        "jscpd",
        "apps/api/src",
        "apps/worker/src",
        "libs",
        "db/src",
        "--min-lines",
        "5",
        "--format",
        "python",
        "--ignore",
        "**/tests/**,**/test_*.py,**/migrations/**,**/scripts/**",
        "--reporters",
        "json",
        "--silent",
        "--absolute",
        "--output",
        "{output}/jscpd-python"
      ],
      "parser": "jscpd",
      "report": "jscpd-python/jscpd-report.json",
      "scope": "Python runtime source",
      "successExitCodes": [0],
      "target": 0,
      "direction": "lower"
    },
    "react-doctor": {
      "command": [
        "pnpm",
        "exec",
        "react-doctor",
        "--yes",
        "--json",
        "--no-dead-code",
        "--no-supply-chain",
        "--no-telemetry",
        "--blocking",
        "none"
      ],
      "parser": "reactDoctor",
      "scope": "admin, store, @essesion/shared",
      "successExitCodes": [0],
      "target": 0,
      "direction": "lower"
    },
    "vulture": {
      "command": [
        "uv",
        "run",
        "vulture",
        "apps/api/src",
        "apps/worker/src",
        "libs",
        "db/src",
        "--min-confidence",
        "60",
        "--exclude",
        "*/tests/*,*/test_*.py,*/migrations/*,*/scripts/*",
        "--ignore-decorators",
        "@*.get,@*.post,@*.put,@*.patch,@*.delete,@*.api_route,@field_validator,@model_validator,@computed_field",
        "--ignore-names",
        "model_config,cls"
      ],
      "parser": "vulture",
      "scope": "Python runtime source, confidence >= 60",
      "successExitCodes": [0, 3],
      "target": 0,
      "direction": "lower"
    }
  }
}
